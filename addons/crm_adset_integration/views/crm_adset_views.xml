<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AdSet Form View -->
    <record id="view_crm_adset_form" model="ir.ui.view">
        <field name="name">crm.adset.form</field>
        <field name="model">crm.adset</field>
        <field name="arch" type="xml">
            <form string="Ad Set Integration">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_leads" type="object" class="oe_stat_button" icon="fa-user">
                            <field name="lead_count" widget="statinfo" string="Leads"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. AdSet - Dental - Riyadh"/></h1>
                    </div>
                    <group>
                        <group string="Platform Configuration">
                            <field name="platform"/>
                            <field name="external_id" placeholder="e.g. 23851940182470"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="UTM Campaign Tracking">
                            <field name="campaign_id"/>
                            <field name="source_id"/>
                            <field name="medium_id"/>
                        </group>
                    </group>
                    <group string="Automatic Lead Routing &amp; Assignment">
                        <group>
                            <field name="team_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- AdSet List View -->
    <record id="view_crm_adset_list" model="ir.ui.view">
        <field name="name">crm.adset.list</field>
        <field name="model">crm.adset</field>
        <field name="arch" type="xml">
            <list string="Ad Sets">
                <field name="name"/>
                <field name="platform"/>
                <field name="external_id"/>
                <field name="campaign_id"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <field name="lead_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- AdSet Action -->
    <record id="action_crm_adset" model="ir.actions.act_window">
        <field name="name">Ad Sets (المجموعات الإعلانية)</field>
        <field name="res_model">crm.adset</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                أنشئ أول مجموعة إعلانية لربط الإعلانات بالـ CRM!
            </p>
            <p>
                قم بإضافة كود المجموعة الإعلانية المأخوذ من فيسبوك أو جوجل لتحديد فريق المبيعات والوسوم وتتبع الليدز فورياً.
            </p>
        </field>
    </record>

    <!-- Menu Item under CRM -> Configuration -->
    <menuitem id="menu_crm_adset"
              name="Ad Sets (المجموعات الإعلانية)"
              parent="crm.crm_menu_config"
              action="action_crm_adset"
              sequence="25"/>
</odoo>
